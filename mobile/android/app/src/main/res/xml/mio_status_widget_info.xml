<?xml version="1.0" encoding="utf-8"?>
<!-- M-6.5 — `AppWidgetProviderInfo` for the home/lock-screen status
     widget. Min size 2x1 grid cells; resizable horizontally so the
     user can stretch it; `widgetCategory` declares lock-screen
     compatibility on OEMs that support it (Pixel 6+, Samsung One UI
     4+). On stock Android the lock-screen flag is silently ignored
     and the widget falls back to home-screen-only placement. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_status"
    android:previewLayout="@layout/widget_status"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:configure=""
    tools:ignore="UnusedAttribute"
    xmlns:tools="http://schemas.android.com/tools" />
