    <!-- M-8 — standalone "How to touch the avatar" page, reachable
         from the info button in the top-right menu. Used to live as a
         card inside the settings sheet; see [GestureGuideScreen]. -->
    <string name="gesture_guide_title">How to touch the avatar</string>

    <!-- M-2.8 — settings sheet. Reachable from the cog icon in the chat
         surface's top bar; replaces the inline "Battery" + "Forget"
         affordances. Mobile-only knobs that don't belong on the desktop's
         settings page (haptics, the swipe-up shortcut), plus thin mirrors
         of the desktop's gesturePrefs so the user can toggle them from
         the device they're holding without round-tripping through the PC. -->
    <string name="chat_a11y_settings">Open settings</string>
    <string name="settings_title">Mio settings</string>
    <string name="settings_back">Back</string>
    <string name="settings_open_action">Open</string>
    <string name="settings_section_touch">Touch interactions</string>
    <string name="settings_section_device">Device</string>
    <string name="settings_footer_hint">More options (API keys, model, personality, voice) live on the desktop\'s Settings page.</string>

    <string name="settings_gestures_enabled">Touch reactions</string>
    <string name="settings_gestures_enabled_hint">Let Mio respond when you tap, stroke, or pinch on the avatar. Off makes the canvas inert.</string>
    <string name="settings_haptics">Haptic feedback</string>
    <string name="settings_haptics_hint">Pulse the phone\'s vibrator the moment a gesture lands, so you can feel it through your finger.</string>
    <string name="settings_swipe_up_history">Swipe-up to open history</string>
    <string name="settings_swipe_up_history_hint">From the bottom 40% of the screen, drag up to expand the chat history. Off if you keep triggering it by accident.</string>

    <!-- Voice-input (STT) language. The recognizer transcribes one
         language at a time; the device locale is a bad proxy, so this
         is an explicit pick. -->
    <string name="settings_section_voice">Voice input</string>
    <string name="settings_voice_language">Recognition language</string>
    <string name="settings_voice_language_hint">The language voice mode listens for. Pick the one you actually speak to Mio — the recognizer handles one language at a time, so the right pick keeps accuracy high.</string>
    <string name="settings_voice_language_en">English</string>
    <string name="settings_voice_language_zh">中文</string>

    <!-- Issue-2: mobile-side auto-loop filters. The desktop owns the
         cycle interval / cost cap / hourly cap; these are this phone\'s
         independent receive switches. -->
    <string name="settings_section_auto">Auto-loop on this phone</string>
    <string name="settings_receive_proactive">Receive proactive messages</string>
    <string name="settings_receive_proactive_hint">When Mio\'s autonomous loop on the desktop decides to say something on her own (a check-in, a follow-up), let it land on this phone too. Off keeps the phone silent until you start the conversation.</string>
    <string name="settings_voice_replies">Voice replies</string>
    <string name="settings_voice_replies_hint">Play Mio\'s TTS audio through this phone\'s speakers. Off still shows captions and history, so you can read along on a muted phone.</string>
    <string name="settings_auto_desktop_hint">Cycle interval, daily cost cap, and hourly limits are managed on the desktop where the agent loop runs.</string>

    <!-- Autonomous-perception gates. These only affect Mio\'s background
         camera / screen pulls; the manual buttons in the chat bar
         remain functional and the captures they produce ARE persisted
         into the chat history. -->
    <string name="settings_section_perception">Auto camera &amp; screen</string>
    <string name="settings_camera_auto">Let Mio glance through the camera</string>
    <string name="settings_camera_auto_hint">When her autonomous loop on the desktop wants a fresh view of what you\'re looking at, she can pull a frame from this phone\'s back camera. Off keeps the camera silent unless you hand her one yourself.</string>
    <string name="settings_screen_auto">Let Mio glance at the phone screen</string>
    <string name="settings_screen_auto_hint">Same idea for the phone screen via MediaProjection: off blocks the autonomous pulls, the manual screen-share button is unaffected.</string>
    <string name="settings_camera_auto_grant">Grant camera access</string>
    <string name="settings_camera_auto_grant_hint">The toggle is on but Mio still can\'t see — Android needs you to allow camera access for this app first.</string>
    <string name="settings_screen_auto_grant">Grant screen sharing</string>
    <string name="settings_screen_auto_grant_hint">The toggle is on but Mio still can\'t see the screen — Android needs a one-time screen-sharing consent (the same dialog the chat dock\'s screen button shows).</string>

    <!-- M-10 — background overlay (floating bubble + chat dock). The
         dock follows your phone when you switch to another app so you
         can keep chatting without coming back to Mio first. -->
    <string name="settings_section_overlay">Background overlay</string>
    <string name="settings_overlay_enabled">Float a chat bubble over other apps</string>
    <string name="settings_overlay_enabled_hint">Pin a floating Mio bubble to the screen whenever this app is in the background. Tap to unfold a chat dock; tap the caption to come back to the full app. Needs Android\'s "Display over other apps" permission.</string>
    <string name="settings_overlay_grant">Grant overlay permission</string>
    <string name="settings_overlay_grant_hint">Opens system Settings so you can flip "Display over other apps" on for Mio.</string>

    <string name="settings_battery_guide">Background reliability</string>
    <string name="settings_battery_guide_hint">Walks you through your phone\'s battery settings so Mio stays online when the screen is off.</string>
    <string name="settings_unpair">Forget this desktop</string>
    <string name="settings_unpair_hint">Clear the saved pairing and stop trying to reach the current desktop. You\'ll need to scan a fresh QR to reconnect.</string>

    <!-- Touch-gesture reference. Mirrors the eight verbs the avatar's
         JS gesture controller recognises (`desktop/src/renderer/avatar/
         gestures.ts`) but described in the active "what you do with your
         finger" voice so the user doesn't need to read source to learn
         how to drive Mio. -->
    <string name="settings_guide_intro">Mio\'s body is split into regions — head, arms, hips, hair, skirt, and more. Each touch verb below works on any region she has.</string>
    <string name="settings_guide_poke_title">Poke — quick tap</string>
    <string name="settings_guide_poke_body">A single tap anywhere on Mio. Use it to get her attention or for a quick comment from her.</string>
    <string name="settings_guide_pat_title">Pat — double tap</string>
    <string name="settings_guide_pat_body">Two taps on the same region within half a second. Lands warmer than a poke.</string>
    <string name="settings_guide_caress_title">Caress — gentle press &amp; hold</string>
    <string name="settings_guide_caress_body">Soft, motionless touch held for about 1.5 seconds. Lift to release.</string>
    <string name="settings_guide_stroke_title">Stroke — slide along a limb</string>
    <string name="settings_guide_stroke_body">Drag your finger along an arm, leg, or her hair in the direction the limb runs.</string>
    <string name="settings_guide_tickle_title">Tickle — wiggle on a ticklish spot</string>
    <string name="settings_guide_tickle_body">Quick back-and-forth wiggling on her sides, palms, feet, or other ticklish zones.</string>
    <string name="settings_guide_grab_title">Grab — firm press &amp; hold</string>
    <string name="settings_guide_grab_body">Same as caress, but press harder. Reads as a confident hold rather than a tender touch.</string>
    <string name="settings_guide_tug_title">Tug — pull on hair, skirt, or ribbon</string>
    <string name="settings_guide_tug_body">Touch a hair strand or her skirt hem, then drag it noticeably away from where it normally hangs.</string>
    <string name="settings_guide_pinch_title">Pinch — two-finger squeeze</string>
    <string name="settings_guide_pinch_body">Place two fingers on her, then bring them closer together. Works best on cheeks, ears, or small targets.</string>
    <string name="settings_guide_swipe_title">Open history — swipe up from below</string>
    <string name="settings_guide_swipe_body">Start a touch below Mio\'s feet and slide up. Toggle this off above if it gets in your way.</string>
</resources>
