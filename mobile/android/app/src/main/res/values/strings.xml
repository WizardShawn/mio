    <string name="agent_loading">Reaching the desktop…</string>
    <string name="agent_section_state">Current state</string>
    <string name="agent_section_loop">Loop schedule</string>
    <string name="agent_enabled">Auto loop on</string>
    <string name="agent_enabled_hint">When on, the desktop wakes Mio every cycle to glance around and check in. Off keeps her quiet until you start the conversation.</string>
    <string name="agent_interval">Interval (minutes)</string>
    <string name="agent_interval_hint">How long between automatic cycles. Lower = more chatter, more cost. Desktop default is 10.</string>
    <string name="agent_save">Save</string>
    <string name="agent_action_pause">Pause / resume</string>
    <string name="agent_action_pause_hint">Halt the loop without flipping the master switch — useful for a quiet hour.</string>
    <string name="agent_action_run_now">Run a cycle now</string>
    <string name="agent_action_run_now_hint">Fire one cycle immediately, independent of the schedule.</string>
    <string name="agent_action_run">Run</string>
    <string name="agent_footer_hint">Daily cost cap, hourly caps, and perception mode stay on the desktop where there\'s room to explain them.</string>
