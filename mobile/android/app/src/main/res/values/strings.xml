<resources>
    <string name="app_name">Mio</string>

    <!-- Foreground-service notification. The body line includes the
         current connection state in plain language so the user can see
         at a glance whether their phone has a desktop to talk to. -->
    <string name="notification_channel_name">Mio connection</string>
    <string name="notification_channel_description">Sticky notification while Mio is connected to a desktop.</string>
    <string name="notification_title_online">Mio is online</string>
    <string name="notification_title_offline">Mio is offline</string>
    <string name="notification_body_connected">Tap to chat.</string>
    <string name="notification_body_connecting">Reaching the desktop…</string>
    <string name="notification_body_disconnected">Lost the connection — retrying.</string>
    <string name="notification_body_unpaired">Pair with a desktop to start.</string>

    <!-- M-2.6 — `chat.showWarning` heads-up channel. Kept separate from
         the sticky connection channel so the user can mute one without
         hiding the other. Only fires when the UI is backgrounded; while
