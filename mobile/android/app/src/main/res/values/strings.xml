    <string name="warning_channel_description">Heads-up notification when Mio\'s agent loop pauses or hits a cap.</string>
    <string name="warning_notification_title">Mio needs your attention</string>
    <string name="chat_warning_dismiss">Dismiss</string>

    <!-- Pairing UI. -->
    <string name="pairing_headline">Pair with Mio on the desktop</string>
    <string name="pairing_subline">Open Mio Settings → Mobile on your PC and scan the QR code.</string>
    <string name="pairing_scan_button">Scan QR code</string>
    <string name="pairing_manual_button">Pair manually</string>
    <string name="pairing_manual_hint">Paste the mio://pair URI from the desktop\'s Mobile settings here.</string>
    <string name="pairing_cancel">Cancel</string>
    <string name="pairing_done">Pair</string>
    <string name="pairing_camera_denied">Camera permission is required to scan the QR. You can also pair manually by URI.</string>
    <string name="pairing_invalid_uri">That doesn\'t look like a Mio pairing URI.</string>

