    <!-- M-3.7 — privacy-honest banner shown briefly when the agent
         loop asks for and receives a camera frame without explicit
         user interaction. We tag the facing so the user can tell
         whether their selfie cam just fired. -->
    <string name="perception_banner_back">Mio glanced through the back camera.</string>
    <string name="perception_banner_front">Mio glanced through the front camera.</string>
    <string name="perception_banner_screen">Mio glanced at your phone screen.</string>
    <string name="perception_banner_screen_failed">Couldn\'t share the phone screen with Mio — screen sharing may have been revoked.</string>
    <string name="perception_banner_screen_needs_grant">Mio wanted a screenshot but screen sharing isn\'t granted — toggle "Let Mio glance at the phone screen" off and on again to re-grant.</string>
    <string name="attachment_too_large">That file is too big to send — keep it under 20 MB.</string>
    <string name="attachment_unsupported">That file type isn\'t supported. Try a JPEG, PNG, GIF, WebP, or PDF.</string>
    <string name="attachment_menu_image">Pick a photo</string>
    <string name="attachment_menu_pdf">Pick a PDF</string>
    <string name="attachment_menu_screenshot">Capture phone screen</string>
    <string name="attachment_a11y">Attach</string>

    <!-- M-5.4 — foreground-app accessibility service. The label +
         description appear in Android's Settings → Accessibility list;
         the description is the user's explainer at the moment they
         choose to enable it. -->
    <string name="accessibility_service_label">Mio foreground-app awareness</string>
    <string name="accessibility_service_description">Lets Mio see which app is open on your phone — the app\'s name only, never what\'s on screen or any text inside it. Helps Mio understand what you\'re doing. You can turn this off any time.</string>

    <!-- M-6.3 — `notification.surface` heads-up channel. Separate from the
         agent-alerts channel so the user can mute either bucket
         independently. Default importance is HIGH so the notification
         peeks; the desktop sets `priority: 'normal'` (mapped to DEFAULT)
         when it just wants a quiet entry. -->
    <string name="surface_channel_name">Mio messages</string>
    <string name="surface_channel_description">Heads-up when Mio has something proactive to tell you (matches the desktop toast).</string>

    <!-- M-6.4 — Quick Settings tile. Shown in the system QS edit screen
         and as the tile subtitle. -->
    <string name="qs_tile_label">Mio</string>
    <string name="qs_tile_subtitle_connected">Connected</string>
    <string name="qs_tile_subtitle_offline">Offline</string>
    <string name="qs_tile_subtitle_unpaired">Pair to start</string>

    <!-- M-6.5 — home/lock-screen widget. The label is the picker name in
         the launcher\'s widget tray; the state lines render inside the
         widget itself. -->
    <string name="widget_label">Mio status</string>
    <string name="widget_description">Live connection state for your paired Mio desktop.</string>
    <string name="widget_state_unpaired">Mio · pair to start</string>
    <string name="widget_state_offline">Mio · offline</string>
    <string name="widget_state_connecting">Mio · connecting…</string>
    <string name="widget_state_idle">Mio · idle</string>
    <string name="widget_state_talking">Mio · talking</string>

    <!-- M-7.2 — OEM battery-optimization explainer. Shown from the
         settings sheet in the chat surface. Each OEM gets its own
         short hand-tuned line; the generic fallback covers stock
         Android plus any manufacturer we haven\'t catalogued yet. -->
    <string name="battery_guide_title">Keep Mio alive in the background</string>
    <string name="battery_guide_intro">Android lets some manufacturers shut down apps to save battery, even ones running a foreground service. To keep Mio connected while your screen is off, do the steps below for your device.</string>
    <string name="battery_guide_step_ignore_optimizations">Turn off battery optimization</string>
    <string name="battery_guide_step_ignore_optimizations_body">Ask Android to leave Mio alone in the background. Required on every device.</string>
    <string name="battery_guide_button_ignore_optimizations">Open battery settings</string>
    <string name="battery_guide_oem_xiaomi">Xiaomi / Redmi (MIUI)</string>
    <string name="battery_guide_oem_xiaomi_body">Open Settings → Apps → Manage apps → Mio. Enable "Autostart" and set "Battery saver" to "No restrictions."</string>
    <string name="battery_guide_oem_samsung">Samsung (One UI)</string>
    <string name="battery_guide_oem_samsung_body">Settings → Battery and device care → Battery → Background usage limits → Never sleeping apps → add Mio.</string>
    <string name="battery_guide_oem_huawei">Huawei / Honor (EMUI)</string>
    <string name="battery_guide_oem_huawei_body">Settings → Battery → App launch → Mio → switch to Manage manually and enable all three toggles.</string>
    <string name="battery_guide_oem_oppo">OPPO / OnePlus / Realme (ColorOS)</string>
    <string name="battery_guide_oem_oppo_body">Settings → Battery → Battery usage → Mio → enable "Allow background activity" and "Allow auto-launch."</string>
    <string name="battery_guide_oem_vivo">Vivo / iQOO (Funtouch / OriginOS)</string>
    <string name="battery_guide_oem_vivo_body">Settings → Battery → Background power consumption management → Mio → set to "Allow."</string>
    <string name="battery_guide_oem_generic">Stock Android / other</string>
    <string name="battery_guide_oem_generic_body">Stock Android lets the "Turn off battery optimization" button above do the whole job. If Mio still gets killed overnight, check your launcher for an extra app-protection setting.</string>
    <string name="battery_guide_open_oem">Open OEM battery settings</string>
    <string name="battery_guide_close">Back</string>
    <string name="chat_settings_battery">Battery guide</string>

