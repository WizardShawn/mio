<?xml version="1.0" encoding="utf-8"?>
<!-- M-6.5 — soft rounded background for the home/lock-screen widget.
     Color matches the chat surface's gradient so the widget reads as
     a continuation of the app, not a stock white block. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1C1F2A" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
