<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a Cortana-style ring — a pale outer halo
     around a vivid inner ring, with a transparent core so the white
     launcher background (mio_launcher_bg) reads through as the natural
     white centre. The same drawable doubles as the monochrome themed
     icon, where the two rings flatten into a single tinted donut.

     Both rings are drawn as evenOdd annuli (outer circle + inner
     circle in one path) so the core is genuinely transparent rather
     than a painted-on white disc — that keeps the themed-icon variant
     a clean ring instead of a solid blob. The artwork sits inside the
     66dp adaptive-icon safe zone (outer radius 32, centred at 54,54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Pale outer halo. -->
    <path
        android:fillColor="#FFA6DCF5"
        android:fillType="evenOdd"
        android:pathData="M22,54 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0 Z M27.5,54 a26.5,26.5 0 1,0 53,0 a26.5,26.5 0 1,0 -53,0 Z" />
    <!-- Vivid inner ring. -->
    <path
        android:fillColor="#FF26A4DE"
        android:fillType="evenOdd"
        android:pathData="M27.5,54 a26.5,26.5 0 1,0 53,0 a26.5,26.5 0 1,0 -53,0 Z M37,54 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 Z" />
</vector>
