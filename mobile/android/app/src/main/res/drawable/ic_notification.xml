<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification icon. Must be a monochrome white silhouette
     with everything else transparent — the system tints it. A
     Cortana-style ring: a white donut (evenOdd annulus) with a
     transparent core, matching the launcher icon's silhouette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2,12 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z M7,12 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
</vector>
