<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase M-1 baseline. Camera + foreground-service-camera expand
         in M-3 (back-cam perception); media projection arrives in M-5.
         M-2's "Grok-Mika" rework dropped the original SYSTEM_ALERT_WINDOW
         design in favour of a full-screen in-app avatar surface, so no
         overlay permission is needed — agent warnings reach the user via
         heads-up notifications instead (see `MioForegroundService`'s
         WARNING_CHANNEL_ID). We declare only what each phase actually
         uses, so first-run never asks for a permission the user can't
         yet justify. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service holds the WS connection alive while the app is
         backgrounded. API 34 split FOREGROUND_SERVICE into typed buckets;
         dataSync covers "we're maintaining a long-lived sync to the user's
         desktop". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Phase M-5 — the service additionally claims the mediaProjection
         foreground-service type while a screen-capture projection is
         live. Android 14 requires the type be set before
         getMediaProjection() is called. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- The floating-bubble STT path runs SpeechRecognizer from the
         foreground service while MainActivity is backgrounded. Android
         14+ blocks mic access from a background activity, so the FGS
         must claim the `microphone` type — which itself requires this
         permission. In-app STT runs while MainActivity is foreground
         and didn't need it, which is why the original M-4 baseline
         omitted it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- POST_NOTIFICATIONS gates the sticky "Mio is online" notification on
         API 33+. Pre-33 phones don't need the runtime grant. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- mDNS discovery uses NsdManager which works without an explicit
         permission, but Wi-Fi multicast on some OEMs requires holding a
         multicast lock — CHANGE_WIFI_MULTICAST_STATE is the gate. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Camera is used today only by the QR-pair scanner; Phase M-3
         expands it to back-cam perception streaming. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Phase M-4 — RECORD_AUDIO gates the SpeechRecognizer used by
         voice-input mode. Hold-to-talk was dropped in favour of a
         tap-to-toggle voice mode; recognition only runs while the app
         is foreground, so no FOREGROUND_SERVICE_MICROPHONE type is
         needed. Runtime grant is requested lazily on the first mic tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- M-2.8 — short haptic pulses fired when the JS gesture controller
         classifies a touch. Normal protection level (no runtime prompt);
         the user-facing toggle is in the in-app Settings screen, not the
         system permission dialog. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- M-10 — background overlay (floating bubble + bottom chat dock)
         shown whenever the main activity is not in the foreground.
         Lets the user keep chatting with Mio while another app is on
         top. SYSTEM_ALERT_WINDOW is a special "Display over other apps"
         permission that the user must grant from system Settings; the
         in-app overlay toggle drives the prompt via
         ACTION_MANAGE_OVERLAY_PERMISSION. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The LAN transport is cleartext by design: the WS connection
         (ws://), the asset HTTP mirror, and TTS-chunk audio all talk
         http:// to the user's own desktop on the local network (or a
         Tailscale host). targetSdk 34 blocks cleartext by default, so
         it must be opted back in or every connection fails the network
         security policy. -->
    <application
        android:name=".MioApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MioMobile"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MioMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep-link handler so a `mio://pair?…` URI tapped from the
                 desktop's Settings page (or shared by some other channel)
                 lands directly in the pairing flow. The QR scanner returns
                 the same URI shape, so the parser is single-source. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mio" android:host="pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MioForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection|microphone" />

        <!-- M-5.4 — foreground-app intel. The system binds this; it is
             gated behind BIND_ACCESSIBILITY_SERVICE so only the OS can.
             The service reads the foreground package name ONLY — see
             res/xml/accessibility_service_config.xml. -->
        <service
            android:name=".service.MioAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- M-6.4 — Quick Settings tile. The system binds this on demand
             when the user adds the "Mio" tile to their QS edit screen;
             it is gated behind BIND_QUICK_SETTINGS_TILE so only the OS
             can. State mirrors `MioForegroundService.connState` via
             the `MioStatusBroadcast` action; tap opens MainActivity. -->
        <service
            android:name=".service.MioQuickSettingsTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- M-6.5 — home / lock-screen widget. The provider renders the
             current connection + avatar talking/idle state into a 2x1
             RemoteViews layout. Updates land via the same
             MioStatusBroadcast pipe the QS tile uses. -->
        <receiver
            android:name=".widget.MioStatusWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="io.mio.mobile.action.STATUS_STATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mio_status_widget_info" />
        </receiver>

    </application>

</manifest>
