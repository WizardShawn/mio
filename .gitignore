# ─── Secrets — nothing below this heading may ever reach a commit ───
.env
.env.local
**/.env
**/.env.local
**/*.pem
**/*.key
**/*.jks
**/*.keystore

# Machine-local agent settings (leak the developer's drive layout)
.claude/
**/.claude/

# ─── Personal configuration ───
# The shipped persona.md is the professional default. A local override is
# personal to whoever runs it and is never committed.
persona.local.md

# ─── Node / npm ───
node_modules/
.npm/
.pnpm-store/

# ─── Electron build artifacts ───
# NOTE: `build/` is deliberately NOT ignored — it holds icon.png and the
# electron-builder inputs, which are source. Build OUTPUT goes to out/ and
# release/, per the `directories.output` setting in package.json.
out/
release/
dist/
.vite/
.cache/
*.tsbuildinfo

# Playwright browser bundle (downloaded at install time, not source)
pw-browsers/

# ─── Runtime state ───
# The memory database, encrypted key blobs and preferences live in
# %APPDATA%/cortana-desktop-assistant/, not here — these are belt-and-braces
# in case anyone points userData at the repo while debugging.
*.db
*.sqlite
*.sqlite3
*.enc
user-preferences.json

# ─── Logs ───
*.log

# ─── OS / IDE noise ───
.DS_Store
Thumbs.db
.vscode/
.idea/
